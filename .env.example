# ---- LLM (any OpenAI-compatible provider) ----
# groq         -> get a key at https://console.groq.com/keys  (free tier; rate limited)
# ollama_cloud -> get a key at https://ollama.com/settings/keys
# ollama_local -> no key; run `ollama serve` and `ollama pull llama3.1:8b`
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides (defaults come from the provider preset in backend/app/config.py)
# LLM_BASE_URL=
# LLM_STRONG=llama-3.3-70b-versatile
# LLM_FAST=llama-3.1-8b-instant

# ---- storage ---- (default: SQLite file at data/argus.db)
# DB_URL=postgresql+psycopg://user:pass@host/db

# ---- crawler identity (shown in User-Agent to sites we fetch) ----
USER_AGENT_EMAIL=you@example.com

# ---- optional ----
# SCHEDULER_ENABLED=false
# SLACK_WEBHOOK_URL=
