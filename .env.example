# ---- LLM: a pool of FREE tiers with automatic failover (backend/app/llm_pool.py) ----
# Every key is optional; each one you add is more free capacity. When one hits its daily cap, the next takes over.
GROQ_API_KEY=            # console.groq.com/keys: 3 free models, ~200k tokens/day EACH
MISTRAL_API_KEY=         # console.mistral.ai: free "Experiment" plan (phone verification; data may be used for training)
GEMINI_API_KEY=          # aistudio.google.com/apikey: free tier
OPENROUTER_API_KEY=      # openrouter.ai/keys: ":free" models, 50 requests/day
# OLLAMA_LOCAL=true      # a local `ollama serve`: unlimited and offline, needs a capable PC
# OLLAMA_API_KEY=        # Ollama Cloud: needs paid credits
# Older single-key setup still works: LLM_PROVIDER=groq + LLM_API_KEY=...
# Custom order: LLM_STRONG_CHAIN=groq:openai/gpt-oss-120b,mistral:mistral-medium-latest
# Check every key:  cd backend && .venv/Scripts/python -m app.llm_check

# ---- security (REQUIRED for Docker / VEYRA_ENV=production) ----
# The admin password protects every page and API call. Leave empty only for local development.
VEYRA_ADMIN_PASSWORD=
# Signs session cookies. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
VEYRA_SECRET_KEY=
# Set to false only for plain-HTTP access from other devices on your own network.
# VEYRA_COOKIE_SECURE=true
# VEYRA_PORT=8000

# ---- crawler identity (shown in the User-Agent to sites Veyra fetches) ----
USER_AGENT_EMAIL=you@example.com

# ---- optional ----
# SCHEDULER_ENABLED=true      # run a collection + agent cycle automatically (default on in Docker)
# CYCLE_INTERVAL_MIN=360      # every 6 hours
# Web Push keys are generated automatically into the data volume; to pin your own:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# SLACK_WEBHOOK_URL=          # post daily briefs to Slack
# LOG_LEVEL=INFO
