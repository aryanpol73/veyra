# ---- LLM (any OpenAI-compatible provider) ----
# groq         -> key at https://console.groq.com/keys (free tier: 8k tokens/min, 200k tokens/day per model)
# ollama_cloud -> key at https://ollama.com/settings/keys (needs paid credits)
# ollama_local -> no key; run `ollama serve` and `ollama pull llama3.1:8b`
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_STRONG=openai/gpt-oss-120b
# LLM_FAST=openai/gpt-oss-20b

# ---- security (REQUIRED for Docker / VEYRA_ENV=production) ----
# The admin password protects every page and API call. Leave empty only for local development.
VEYRA_ADMIN_PASSWORD=
# Signs session cookies. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
VEYRA_SECRET_KEY=
# Set to false only for plain-HTTP access from other devices on your own network.
# VEYRA_COOKIE_SECURE=true
# VEYRA_PORT=8000

# ---- crawler identity (shown in the User-Agent to sites Veyra fetches) ----
USER_AGENT_EMAIL=you@example.com

# ---- optional ----
# SCHEDULER_ENABLED=true      # run a collection + agent cycle automatically
# CYCLE_INTERVAL_MIN=720
# SLACK_WEBHOOK_URL=          # post daily briefs to Slack
# LOG_LEVEL=INFO
